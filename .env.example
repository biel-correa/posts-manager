# Required: Your Google AI Studio / Gemini Developer API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Text & Web Search Grounding Model
# Recommended options:
#   - gemini-3.8-flash      (Default: fast, balanced cost & strong Google Search grounding)
#   - gemini-4-argon        (Flagship reasoning: deepest technical analysis of engineering blogs)
#   - gemini-3.5-flash-lite (Fastest & lowest cost)
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite

# Image Generation Model
# Recommended options:
#   - gemini-nano-banana-2.1     (Default: Nano Banana 2.1 — crisp 4:5 & 1:1 editorial illustrations)
#   - gemini-3-pro-image         (Nano Banana Pro — highest visual fidelity & fine linework)
#   - gemini-3.1-flash-lite-image (Fastest, lowest-cost image iteration)
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1

# Gemini API Capabilities & Tier Settings:
# - Grounding with Google Search and Nano Banana Image generation are Paid Tier (Tier 1+) features on the Gemini API.
# - On the Free Tier (unpaid Google AI Studio key), set both to false to run 100% free of charge.
# - The application will also automatically fall back to ungrounded post generation if quota errors occur.
GEMINI_SEARCH_GROUNDING=false
GEMINI_IMAGE_GENERATION=false

# Schedule & Timezone Configuration
# Weeks are anchored to Sunday 00:00 in TZ. If the app wasn't running on Sunday,
# it automatically creates missing posts for the CURRENT week only (max 1 week catch-up).
TZ=America/Sao_Paulo
POSTS_PER_WEEK=3
SUNDAY_CRON=0 8 * * 0

# Web Server Port
PORT=8080

# Optional: Discord, Slack, or Generic JSON Webhook URL notified when Sunday posts finish
WEBHOOK_URL=
